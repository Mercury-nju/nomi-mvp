# Local, single-user deployment. Keep secrets outside Git.
NOMI_DATA_DIR=.data
# Optional: reuse a logged-in browser profile only while its browser is closed.
# NOMI_BROWSER_PROFILE=C:/path/to/browser-profile
# Optional OpenAI-compatible model endpoint. Without these, the planner uses
# explicit rules and asks for missing details; no generated result is fabricated.
# NOMI_LLM_BASE_URL=https://api.openai.com/v1
# NOMI_LLM_MODEL=
# NOMI_LLM_API_KEY=
